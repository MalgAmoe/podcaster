PORT=3000
RUST_LOG=info

# Protect the Rust API from direct public use.
API_KEY=change-me

# Restrict browser-facing preview requests to your Phoenix origin.
# Example:
# CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=

# Required for input download and output upload.
S3_ENDPOINT=https://example.r2.cloudflarestorage.com
S3_BUCKET=poddyclip
S3_REGION=auto
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

# Optional tuning
MAX_FILE_SIZE_MB=2048
JOB_TIMEOUT_SECONDS=600
RESULT_RETENTION_SECONDS=3600
PREVIEW_MAX_SECONDS=30
PREVIEW_TOLERANCE_SECONDS=2.0
PREVIEW_MAX_CONCURRENCY=1
