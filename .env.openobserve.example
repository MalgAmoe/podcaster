# OpenObserve Configuration
# Copy to .env.openobserve and fill in values

# Admin credentials
ZO_ROOT_USER_EMAIL=admin@yourdomain.com
ZO_ROOT_USER_PASSWORD=YourSecurePassword

# Cloudflare R2 storage
# Create bucket 'openobserve-data' in R2 first
ZO_S3_SERVER_URL=https://your-account-id.r2.cloudflarestorage.com
ZO_S3_ACCESS_KEY=your-r2-access-key
ZO_S3_SECRET_KEY=your-r2-secret-key
