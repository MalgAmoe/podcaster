# MinIO S3 Configuration (local dev uses minioadmin/minioadmin)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=poddyclip
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=us-east-1

# Rust API URL
PODDYCLIP_API_URL=http://localhost:3000

# API key for authenticating with Rust API (generate with: openssl rand -hex 32)
API_KEY=your-api-key

# Webhook secret for Rust API callbacks (generate with: openssl rand -hex 32)
WEBHOOK_SECRET=your-webhook-secret
