<div class="min-h-screen bg-base-100">
  <div class="max-w-3xl mx-auto py-16 px-6">
    <h1 class="text-4xl font-bold mb-4"><%= gettext("Blog") %></h1>
    <p class="text-base-content/50 mb-12"><%= gettext("Tips, updates, and stories about audio cleanup") %></p>

    <div class="space-y-6">
      <%= for post <- @posts do %>
        <.link href={locale_path(@locale, "/blog/#{post.slug}")} class="block group">
          <article class="bg-base-200 rounded-2xl p-6 border border-base-300/50 hover:border-primary/30 hover:shadow-[0_4px_20px_-5px_rgba(147,51,234,0.15)] transition-all duration-200">
            <div class="flex flex-col gap-3">
              <%= if post.image do %>
                <img src={post.image} alt={post.title} class="w-full h-48 object-cover rounded-xl" />
              <% end %>
              <time class="text-sm text-base-content/40"><%= format_date(post.date) %></time>
              <h2 class="text-xl font-semibold group-hover:text-primary transition-colors"><%= post.title %></h2>
              <p class="text-base-content/70"><%= post.description %></p>
              <span class="text-primary text-sm font-medium"><%= gettext("Read more") %> &rarr;</span>
            </div>
          </article>
        </.link>
      <% end %>
    </div>

    <%= if @posts == [] do %>
      <div class="text-center py-16 text-base-content/50">
        <p><%= gettext("No posts yet. Check back soon!") %></p>
      </div>
    <% end %>

    <.mini_footer locale={@locale} />
  </div>
</div>
