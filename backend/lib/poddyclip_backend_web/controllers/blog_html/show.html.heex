<div class="min-h-screen bg-base-100">
  <div class="max-w-3xl mx-auto py-16 px-6">
    <.link href={locale_path(@locale, "/blog")} class="text-sm text-base-content/50 hover:text-primary transition-colors mb-8 inline-block">
      &larr; <%= gettext("Back to blog") %>
    </.link>

    <article>
      <header class="mb-8">
        <h1 class="text-4xl font-bold mb-3"><%= @post.title %></h1>
        <time class="text-sm text-base-content/40"><%= format_date(@post.date) %></time>
      </header>

      <%= if @post.image do %>
        <img src={@post.image} alt={@post.title} class="w-full rounded-2xl mb-8" />
      <% end %>

      <div class="prose">
        <%= raw(@post.body) %>
      </div>
    </article>

    <.mini_footer locale={@locale} />
  </div>
</div>
