<div class="min-h-screen bg-base-100">
  <div class="max-w-3xl mx-auto py-16 px-6">
    <h1 class="text-4xl font-bold mb-4">Terms of Service</h1>
    <p class="text-base-content/50 mb-12">Last updated: January 2026</p>

    <div class="space-y-10">
      <section>
        <h2 class="text-2xl font-semibold mb-3">1. Agreement to Terms</h2>
        <p class="text-base-content/80 leading-relaxed">
          By accessing or using Munchy Cow ("the Service"), you agree to be bound by these
