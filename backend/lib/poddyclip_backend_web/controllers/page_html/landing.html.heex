<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Munchy Cow",
  "url": "https://munchycow.com",
  "logo": "https://munchycow.com/images/munchy_cow.svg",
  "description": "Automatic podcast audio cleanup — noise removal, compression, EQ, loudness normalization."
}
</script>
<div class="min-h-screen">
  <!-- Hero -->
  <section class="min-h-[80vh] flex items-center justify-center px-6">
    <div class="max-w-2xl text-center">
      <div class="mb-8">
        <img src="/images/munchy_cow.svg" alt="Munchy Cow" class="w-64 h-auto mx-auto" />
      </div>
      <h1 class="text-5xl md:text-6xl font-bold mb-6">
        <%= gettext("Your podcast deserves") %> <span class="text-primary"><%= gettext("better audio") %></span>
      </h1>
      <p class="text-2xl text-base-content/70 mb-10">
        <%= gettext("Upload your raw recording.") %><br/>
        <%= gettext("Get back broadcast-ready audio in minutes.") %><br/>
        <%= gettext("No plugins. No knobs. No audio degree.") %>
      </p>
      <.link href={locale_path(@locale, "/users/log-in")} class="btn btn-primary btn-lg text-lg px-10">
        <%= gettext("Try it free") %>
      </.link>
      <p class="text-sm text-base-content/50 mt-4">
        <%= gettext("Free to try. No credit card required.") %>
      </p>
    </div>
  </section>

  <!-- Problem -->
  <section class="py-24 px-6 bg-base-200/50">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-4xl font-bold mb-12 text-center">
        <%= gettext("You know the feeling") %>
      </h2>
      <div class="space-y-4 text-xl text-base-content/70">
        <p>
          <%= gettext("You spent an hour getting a great conversation. You listen back and... it sounds like a bedroom. Hum, reverb, volume all over the place. It's fine, but it's not good.") %>
        </p>
        <p class="text-base-content font-medium">
          <%= gettext("You could spend hours in a DAW tweaking settings you half understand. Or feed it to the cow.") %>
        </p>
      </div>
    </div>
  </section>

  <!-- What happens inside -->
  <section class="py-24 px-6">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-4xl font-bold mb-6 text-center">
        <%= gettext("What the cow does to your audio") %>
      </h2>
      <p class="text-xl text-base-content/70 text-center mb-12">
        <%= gettext("Each file is analyzed first, then run through a chain that adapts to what it finds.") %>
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <p class="font-bold text-primary text-xl mb-2"><%= gettext("Clean") %></p>
          <p class="text-base-content/70"><%= gettext("removes the hum, the echo, the mouth clicks") %></p>
        </div>
        <div>
          <p class="font-bold text-primary text-xl mb-2"><%= gettext("Shape") %></p>
          <p class="text-base-content/70"><%= gettext("evens out the volume so nobody's too loud or too quiet") %></p>
        </div>
        <div>
          <p class="font-bold text-primary text-xl mb-2"><%= gettext("Polish") %></p>
          <p class="text-base-content/70"><%= gettext("adds the warmth and clarity that makes audio sound expensive") %></p>
        </div>
        <div>
          <p class="font-bold text-primary text-xl mb-2"><%= gettext("Deliver") %></p>
          <p class="text-base-content/70"><%= gettext("hits the right loudness for every platform") %></p>
        </div>
      </div>
      <p class="text-base-content/60 mt-12 text-center text-lg">
        <%= gettext("The difference between 'recorded at home' and 'sounds like a studio' isn't one thing. It's a dozen things in the right order.") %>
      </p>
    </div>
  </section>

  <!-- The promise -->
  <section class="py-24 px-6 bg-base-200/50">
    <div class="max-w-2xl mx-auto text-center">
      <p class="text-3xl md:text-4xl font-medium mb-6 leading-snug">
        <%= gettext("Other tools make you sound like a robot.") %><br/>
        <span class="text-base-content/60"><%= gettext("I just make you sound like you recorded somewhere nicer.") %></span>
      </p>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="py-24 px-6">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-4xl font-bold mb-12 text-center">
        <%= gettext("Made for people who'd rather be talking") %>
      </h2>
      <div class="space-y-4 text-xl text-base-content/70">
        <p><%= gettext("Podcasters who don't want to learn a DAW.") %></p>
        <p><%= gettext("YouTubers who know their audio could be better.") %></p>
        <p><%= gettext("Voice actors tired of tweaking plugin chains before every audition.") %></p>
        <p><%= gettext("Anyone who's ever googled \"why does my podcast sound bad\" at midnight.") %></p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 px-6 bg-base-200/50">
    <div class="max-w-xl mx-auto text-center">
      <p class="text-4xl font-bold mb-4">
        <%= gettext("Upload something.") %>
      </p>
      <p class="text-4xl font-bold text-base-content/50 mb-10">
        <%= gettext("See what happens.") %>
      </p>
      <p class="text-lg text-base-content/60 mb-8">
        <%= gettext("3 free hours. No credit card. No sales calls.") %>
      </p>
      <.link href={locale_path(@locale, "/users/log-in")} class="btn btn-primary btn-lg text-lg px-10">
        <%= gettext("Let's go") %>
      </.link>
      <p class="text-sm text-base-content/50 mt-6">
        <%= gettext("Your audio stays private. Files deleted after 7 days.") %>
      </p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-8 px-6 border-t border-base-300">
    <div class="max-w-4xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
      <span class="text-base-content/50 flex items-center gap-1"><img src="/images/munchy_cow_head.svg" alt="" class="w-6 h-6" /> Munchy Cow</span>
      <a href="mailto:info@munchycow.com" class="text-sm text-base-content/50 hover:text-base-content transition-colors">info@munchycow.com</a>
      <nav class="flex gap-6 text-sm text-base-content/50">
        <.link href={locale_path(@locale, "/pricing")} class="hover:text-base-content transition-colors"><%= gettext("Pricing") %></.link>
        <.link href={locale_path(@locale, "/terms")} class="hover:text-base-content transition-colors"><%= gettext("Terms") %></.link>
        <.link href={locale_path(@locale, "/privacy")} class="hover:text-base-content transition-colors"><%= gettext("Privacy") %></.link>
        <.link href={locale_path(@locale, "/legal")} class="hover:text-base-content transition-colors">Aviso Legal</.link>
      </nav>
    </div>
  </footer>
</div>
