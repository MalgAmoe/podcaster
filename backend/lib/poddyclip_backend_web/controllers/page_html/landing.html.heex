<main class="bg-base-100 text-base-content">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-10 text-center">
      <div class="space-y-5">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-primary/80">
          AI audio cleanup
        </p>
        <div class="space-y-4">
          <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
            Make your voice recordings sound clean
          </h1>
          <p class="mx-auto max-w-2xl text-lg leading-8 text-base-content/70">
            Strip out background noise, tame harshness, and even out levels, while keeping your voice sounding natural.
          </p>
        </div>
      </div>

      <div class="w-full max-w-lg">
        <div id="solid-landing-trial"></div>
      </div>
    </div>
  </section>
  <.mini_footer />
</main>
