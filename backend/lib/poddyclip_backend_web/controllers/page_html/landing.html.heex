<div class="min-h-screen">
  <!-- Hero - The cow speaks -->
  <section class="min-h-[80vh] flex items-center justify-center px-6">
    <div class="max-w-2xl text-center">
      <div class="mb-8">
        <img src="/images/munchy_cow.svg" alt="Munchy Cow" class="w-64 h-auto mx-auto" />
      </div>
      <h1 class="text-5xl md:text-6xl font-bold mb-6">
        <%= gettext("Give me your") %> <span class="text-primary"><%= gettext("tasty audio") %></span>
      </h1>
      <p class="text-2xl text-base-content/70 mb-10">
        <%= gettext("Munchy Cow offers natural-sounding audio repair.") %><br/>
        <%= gettext("You pay for exactly what I munch—down to the second.") %>
      </p>
      <.link href={locale_path(@locale, "/users/log-in")} class="btn btn-primary btn-lg text-lg px-10">
        <%= gettext("Feed the cow") %>
      </.link>
      <p class="text-sm text-base-content/50 mt-4">
        <%= gettext("Free to try. No credit card required.") %>
      </p>
    </div>
  </section>

  <!-- What I eat -->
  <section class="py-24 px-6 bg-base-200/50">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-4xl font-bold mb-12 text-center">
        <%= gettext("I'm not picky") %>
      </h2>
      <div class="space-y-4 text-xl">
        <p><span class="text-base-content/70"><%= gettext("That fan noise you didn't notice until editing?") %></span> <span class="text-primary font-medium"><%= gettext("Delicious.") %></span></p>
        <p><span class="text-base-content/70"><%= gettext("The bathroom reverb from your \"recording studio\"?") %></span> <span class="text-primary font-medium"><%= gettext("Yum.") %></span></p>
        <p><span class="text-base-content/70"><%= gettext("Volume all over the place?") %></span> <span class="text-primary font-medium"><%= gettext("Nom nom nom.") %></span></p>
        <p><span class="text-base-content/70"><%= gettext("Harsh sibilants making you sound like a snake?") %></span> <span class="text-primary font-medium italic"><%= gettext("chef's kiss") %></span></p>
      </div>
    </div>
  </section>

  <!-- The promise -->
  <section class="py-24 px-6">
    <div class="max-w-2xl mx-auto text-center">
      <p class="text-3xl md:text-4xl font-medium mb-6 leading-snug">
        <%= gettext("Other tools make you sound like a robot.") %><br/>
        <span class="text-base-content/60"><%= gettext("I just make you sound like you recorded somewhere nicer.") %></span>
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 px-6 bg-base-200/50">
    <div class="max-w-xl mx-auto text-center">
      <p class="text-4xl font-bold mb-4">
        <%= gettext("Upload something.") %>
      </p>
      <p class="text-4xl font-bold text-base-content/50 mb-10">
        <%= gettext("See what happens.") %>
      </p>
      <p class="text-lg text-base-content/60 mb-8">
        <%= gettext("15 free minutes. No credit card. No sales calls.") %>
      </p>
      <.link href={locale_path(@locale, "/users/log-in")} class="btn btn-primary btn-lg text-lg px-10">
        <%= gettext("Let's go") %>
      </.link>
      <p class="text-sm text-base-content/50 mt-6">
        <%= gettext("Your audio stays private. Files deleted after 7 days.") %>
      </p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-8 px-6 border-t border-base-300">
    <div class="max-w-4xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
      <span class="text-base-content/50 flex items-center gap-1"><img src="/images/munchy_cow_head.svg" alt="" class="w-6 h-6" /> Munchy Cow</span>
      <a href="mailto:info@munchycow.com" class="text-sm text-base-content/50 hover:text-base-content transition-colors">info@munchycow.com</a>
      <nav class="flex gap-6 text-sm text-base-content/50">
        <.link href={locale_path(@locale, "/pricing")} class="hover:text-base-content transition-colors"><%= gettext("Pricing") %></.link>
        <.link href={locale_path(@locale, "/terms")} class="hover:text-base-content transition-colors"><%= gettext("Terms") %></.link>
        <.link href={locale_path(@locale, "/privacy")} class="hover:text-base-content transition-colors"><%= gettext("Privacy") %></.link>
        <.link href={locale_path(@locale, "/legal")} class="hover:text-base-content transition-colors">Aviso Legal</.link>
      </nav>
    </div>
  </footer>
</div>
