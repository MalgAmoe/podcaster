<div class="min-h-screen bg-base-100">
  <div class="max-w-3xl mx-auto py-16 px-6">
    <h1 class="text-4xl font-bold mb-4"><%= gettext("Help & FAQ") %></h1>
    <p class="text-base-content/50 mb-12"><%= gettext("Answers to common questions about Munchy Cow") %></p>

    <div class="space-y-6">
      <!-- FAQ Items -->
      <div class="collapse collapse-arrow bg-base-200 rounded-2xl">
        <input type="radio" name="faq-accordion" checked="checked" />
        <div class="collapse-title text-lg font-medium">
          <%= gettext("I'm not receiving emails from Munchy Cow") %>
        </div>
        <div class="collapse-content text-base-content/80">
          <p><%= gettext("Please check your spam or junk folder. Our emails sometimes end up there. If you still can't find them, contact us and we'll help you out.") %></p>
        </div>
      </div>

      <div class="collapse collapse-arrow bg-base-200 rounded-2xl">
        <input type="radio" name="faq-accordion" />
        <div class="collapse-title text-lg font-medium">
          <%= gettext("What audio formats are supported?") %>
        </div>
        <div class="collapse-content text-base-content/80">
          <p><%= gettext("We support MP3, WAV, M4A, and FLAC. Your processed audio will be delivered as a high-quality MP3.") %></p>
        </div>
      </div>

      <div class="collapse collapse-arrow bg-base-200 rounded-2xl">
        <input type="radio" name="faq-accordion" />
        <div class="collapse-title text-lg font-medium">
          <%= gettext("How long does processing take?") %>
        </div>
        <div class="collapse-content text-base-content/80">
          <p><%= gettext("Processing typically takes 1-3 minutes per 10 minutes of audio. Longer files or files with AI Clean enabled may take a bit longer.") %></p>
        </div>
      </div>

      <div class="collapse collapse-arrow bg-base-200 rounded-2xl">
        <input type="radio" name="faq-accordion" />
        <div class="collapse-title text-lg font-medium">
          <%= gettext("What does AI Clean do?") %>
        </div>
        <div class="collapse-content text-base-content/80">
          <p><%= gettext("AI Clean uses deep learning to isolate voice from everything else. It's great for removing complex background noise like traffic, music, or fans. It takes longer to process but produces cleaner results for noisy recordings.") %></p>
        </div>
      </div>

      <div class="collapse collapse-arrow bg-base-200 rounded-2xl">
        <input type="radio" name="faq-accordion" />
        <div class="collapse-title text-lg font-medium">
          <%= gettext("How long are my files stored?") %>
        </div>
        <div class="collapse-content text-base-content/80">
          <p><%= gettext("Processed files are available for download for 7 days. After that, they're automatically deleted. Make sure to download your files before they expire!") %></p>
        </div>
      </div>

      <div class="collapse collapse-arrow bg-base-200 rounded-2xl">
        <input type="radio" name="faq-accordion" />
        <div class="collapse-title text-lg font-medium">
          <%= gettext("Is my audio private?") %>
        </div>
        <div class="collapse-content text-base-content/80">
          <p><%= gettext("Yes. Your audio is processed securely and only accessible to you. We don't listen to, share, or use your audio for any purpose other than processing it. Files are automatically deleted after 7 days.") %></p>
        </div>
      </div>

    </div>

    <!-- Contact Section -->
    <div class="mt-16 p-8 bg-base-200 rounded-2xl text-center">
      <h2 class="text-2xl font-semibold mb-4"><%= gettext("Still have questions?") %></h2>
      <p class="text-base-content/70 mb-6"><%= gettext("We're here to help. Reach out and we'll get back to you as soon as possible.") %></p>
      <a href="mailto:support@munchycow.com" class="btn btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
        </svg>
        support@munchycow.com
      </a>
    </div>

    <.mini_footer locale={@locale} />
  </div>
</div>
