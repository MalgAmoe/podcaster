<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center p-4">
  <div class="card bg-base-200 w-full max-w-md border border-base-300 rounded-3xl">
    <div class="card-body">
      <div class="flex items-center gap-3 mb-2">
        <img src="/images/munchy_cow_head.svg" alt="" class="w-10 h-10" />
        <h2 class="text-xl font-bold">Tell us what you think</h2>
      </div>
      <p class="text-sm text-base-content/60 mb-4">
        You're shaping this product. Every response is read personally.
      </p>

      <%= if @submitted do %>
        <div class="alert alert-success text-sm">
          <span>Thanks for your feedback!</span>
        </div>
        <div class="mt-4 text-center">
          <a href="/app" class="btn btn-primary btn-sm">Back to app</a>
        </div>
      <% else %>
        <form action="/feedback" method="post">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <textarea
            name="value"
            class="textarea textarea-bordered w-full"
            rows="4"
            placeholder="What do you need? What would you change? What are you working on?"
            required
          ></textarea>
          <div class="flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary btn-sm">Send feedback</button>
            <a href="/app" class="btn btn-ghost btn-sm">Back to app</a>
          </div>
        </form>
      <% end %>
    </div>
  </div>
</div>
