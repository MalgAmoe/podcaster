<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center p-4">
  <div class="card bg-base-200 w-full max-w-md border border-base-300/60 rounded-3xl shadow-[0_0_60px_-15px_rgba(147,51,234,0.15)]">
    <div class="card-body p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
          <img src="/images/munchy_cow_head.svg" alt="" class="w-8 h-8" />
        </div>
        <div>
          <h2 class="text-lg font-bold">Tell us what you think</h2>
          <p class="text-xs text-base-content/40">Every response is read personally</p>
        </div>
      </div>

      <%= if @submitted do %>
        <div class="flex flex-col items-center py-6">
          <div class="w-14 h-14 rounded-full bg-success/10 flex items-center justify-center mb-4">
            <svg class="w-7 h-7 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <p class="text-base font-medium mb-1">Thanks for your feedback!</p>
          <p class="text-sm text-base-content/40 mb-6">It helps us make Munchy Cow better.</p>
          <a href="/app" class="btn btn-primary btn-sm">Back to app</a>
        </div>
      <% else %>
        <form action="/feedback" method="post">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <textarea
            name="value"
            class="textarea w-full text-sm bg-base-300/40 border-base-300/60 focus:border-primary/50 rounded-2xl resize-none"
            rows="4"
            placeholder="What do you need? What would you change? What are you working on?"
            required
          ></textarea>
          <div class="flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary btn-sm flex-1">Send feedback</button>
            <a href="/app" class="btn btn-ghost btn-sm text-base-content/30">Cancel</a>
          </div>
        </form>
      <% end %>
    </div>
  </div>
</div>
