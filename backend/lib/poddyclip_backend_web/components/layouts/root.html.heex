<!DOCTYPE html>
<html lang="en" data-theme="poddyclip">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={assigns[:meta_description] || "Free audio cleanup. Upload your recording, get back broadcast-ready audio."} />
    <meta name="theme-color" content="#9333ea" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={assigns[:page_title] || "Munchy Cow - Free Audio Cleanup"} />
    <meta property="og:description" content={assigns[:meta_description] || "Free audio cleanup. Upload your recording, get back broadcast-ready audio."} />
    <meta property="og:image" content={assigns[:meta_image] || "https://munchycow.com/images/munchycow-social.png"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={assigns[:page_title] || "Munchy Cow - Free Audio Cleanup"} />
    <meta property="twitter:description" content={assigns[:meta_description] || "Free audio cleanup. Upload your recording, get back broadcast-ready audio."} />
    <meta name="twitter:image" content={assigns[:meta_image] || "https://munchycow.com/images/munchycow-social.png"} />

    <link rel="icon" type="image/svg+xml" href="/images/munchy_cow_head.svg" />
    <link rel="apple-touch-icon" href="/images/munchy_cow_head.svg" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400;1,9..40,500&display=swap" rel="stylesheet">
    <.live_title default="Munchy Cow">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%= if @current_scope && @current_scope.user do %>
      <script>
        window.userToken = <%= raw(Jason.encode!(Phoenix.Token.sign(PoddyclipBackendWeb.Endpoint, "user socket", @current_scope.user.id))) %>;
        window.isGuest = <%= raw(Jason.encode!(@current_scope.user.is_guest)) %>;
        <%= unless @current_scope.user.is_guest do %>
          window.currentUser = <%= raw(Jason.encode!(%{email: @current_scope.user.email, id: @current_scope.user.id})) %>;
        <% end %>
      </script>
    <% end %>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-base-100 min-h-screen">
    <div class="navbar bg-base-200/80 backdrop-blur-lg border-b border-base-300/50 fixed top-0 left-0 right-0 z-40">
      <div class="navbar-start">
        <.link href="/app" class="text-xl font-bold px-4 hover:text-primary transition-colors">Munchy Cow</.link>
        <%= if @current_scope && @current_scope.user && !@current_scope.user.is_guest do %>
          <.link href="/app/past-munchings" class="text-sm px-3 hover:text-primary transition-colors">Past Munchings</.link>
        <% end %>
      </div>
      <div class="navbar-end gap-2 pr-4">

        <%= if @current_scope && @current_scope.user && @current_scope.user.is_guest do %>
          <a href="/users/log-in" class="btn btn-primary btn-sm" rel="external">Sign in</a>
        <% end %>
        <%= if @current_scope && @current_scope.user && !@current_scope.user.is_guest do %>
          <% user = @current_scope.user %>
          <% plan = PoddyclipBackend.Billing.get_user_plan(user) || PoddyclipBackend.Billing.get_or_create_free_plan() %>
          <% total_minutes_available = div(PoddyclipBackend.Billing.get_total_seconds_available(user), 60) %>
          <div class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="w-10 h-10 rounded-full bg-base-300 flex items-center justify-center cursor-pointer hover:ring-2 hover:ring-primary/50 transition-all">
              <img src="/images/munchy_cow_head.svg" alt="" class="w-7 h-7" />
            </div>
            <ul tabindex="0" class="dropdown-content menu bg-base-200 rounded-2xl z-50 w-64 p-2 shadow-lg border border-base-300 mt-2">
              <li class="menu-title px-2 py-1">
                <span class="text-xs text-base-content/50 truncate">{user.email}</span>
                <span class="text-[11px] text-base-content/40 truncate">
                  <span id="navbar-plan-name">{plan.display_name}</span>
                  {" · "}
                  <span id="navbar-minutes-available">{total_minutes_available}</span>
                  {" min available"}
                </span>
              </li>
              <li><a href="/account" rel="external">Account</a></li>
              <li><a href="/users/settings" rel="external">Settings</a></li>
              <li><a href="/help" rel="external">Help & FAQ</a></li>
              <li><.link href="/users/log-out" method="delete">Log out</.link></li>
            </ul>
          </div>
        <% end %>
      </div>
    </div>
    <div style="padding-top: 4rem;">
      {@inner_content}
    </div>
  </body>
</html>
