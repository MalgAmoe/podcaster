<!DOCTYPE html>
<html lang="en" data-theme="poddyclip">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Clean up your podcast audio with Munchy Cow. Remove room echo, background noise, and that weird hum. Get podcast-ready audio in minutes." />
    <meta name="theme-color" content="#9333ea" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Munchy Cow - Audio Cleanup for Podcasters" />
    <meta property="og:description" content="Remove room echo, background noise, and that weird hum. Get podcast-ready audio in minutes." />
    <meta property="og:image" content="/images/munchy_cow.svg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Munchy Cow - Audio Cleanup for Podcasters" />
    <meta name="twitter:description" content="Remove room echo, background noise, and that weird hum. Get podcast-ready audio in minutes." />
    <meta name="twitter:image" content="/images/munchy_cow.svg" />

    <link rel="icon" type="image/svg+xml" href="/images/munchy_cow_head.svg" />
    <link rel="apple-touch-icon" href="/images/munchy_cow_head.svg" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400;1,9..40,500&display=swap" rel="stylesheet">
    <.live_title default="Munchy Cow">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%= if @current_scope do %>
      <script>
        window.userToken = "<%= Phoenix.Token.sign(PoddyclipBackendWeb.Endpoint, "user socket", @current_scope.user.id) %>";
        window.currentUser = { email: "<%= @current_scope.user.email %>", id: <%= @current_scope.user.id %> };
      </script>
    <% end %>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-base-100 min-h-screen">
    <div class="navbar bg-base-200 border-b border-base-300">
      <div class="navbar-start">
        <%= if @current_scope do %>
          <.link href={~p"/app"} class="btn btn-ghost text-xl">Munchy Cow</.link>
        <% else %>
          <.link href={~p"/"} class="btn btn-ghost text-xl">Munchy Cow</.link>
        <% end %>
      </div>
      <div class="navbar-end gap-2">
        <%= if @current_scope do %>
          <.link href={~p"/account"} class="btn btn-ghost btn-sm">Account</.link>
          <div class="dropdown dropdown-end ml-2">
            <div tabindex="0" role="button" class="w-10 h-10 rounded-full bg-base-300 flex items-center justify-center cursor-pointer hover:ring-2 hover:ring-primary/50 transition-all">
              <img src="/images/munchy_cow_head.svg" alt="" class="w-7 h-7" />
            </div>
            <ul tabindex="0" class="dropdown-content menu bg-base-200 rounded-box z-50 w-56 p-2 shadow-lg border border-base-300 mt-2">
              <li class="menu-title px-2 py-1">
                <div class="flex items-center justify-between">
                  <span class="text-xs text-base-content/50 truncate">{@current_scope.user.email}</span>
                  <%= if @current_scope.user.subscription_status == "active" do %>
                    <span class="badge badge-primary badge-xs ml-2">Pro</span>
                  <% else %>
                    <span class="badge badge-ghost badge-xs ml-2">Free</span>
                  <% end %>
                </div>
              </li>
              <%= if @current_scope.user.subscription_status != "active" do %>
                <li class="text-xs text-base-content/50 px-4 py-1">
                  {@current_scope.user.minutes_available} min remaining
                </li>
              <% end %>
              <li><.link href={~p"/account"}>Account</.link></li>
              <li><.link href={~p"/users/settings"}>Settings</.link></li>
              <li><.link href={~p"/users/log-out"} method="delete">Log out</.link></li>
            </ul>
          </div>
        <% else %>
          <.link href={~p"/pricing"} class="btn btn-ghost btn-sm">Pricing</.link>
          <.link href={~p"/users/register"} class="btn btn-ghost btn-sm">Register</.link>
          <.link href={~p"/users/log-in"} class="btn btn-primary btn-sm">Log in</.link>
        <% end %>
      </div>
    </div>
    {@inner_content}
  </body>
</html>
