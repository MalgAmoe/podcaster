<!DOCTYPE html>
<html lang={@locale || "en"} data-theme="poddyclip">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={gettext("Clean up your audio with Munchy Cow. Remove room echo, background noise, and that weird hum. Get natural sounding audio ready to publish in minutes.")} />
    <meta name="theme-color" content="#9333ea" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={gettext("Munchy Cow - Audio Cleanup That Actually Works")} />
    <meta property="og:description" content={gettext("Remove room echo, background noise, and that weird hum. Get natural sounding audio ready to publish in minutes.")} />
    <meta property="og:image" content="/images/munchy_cow.svg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={gettext("Munchy Cow - Audio Cleanup That Actually Works")} />
    <meta name="twitter:description" content={gettext("Remove room echo, background noise, and that weird hum. Get natural sounding audio ready to publish in minutes.")} />
    <meta name="twitter:image" content="/images/munchy_cow.svg" />

    <link rel="icon" type="image/svg+xml" href="/images/munchy_cow_head.svg" />
    <link rel="apple-touch-icon" href="/images/munchy_cow_head.svg" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400;1,9..40,500&display=swap" rel="stylesheet">
    <.live_title default="Munchy Cow">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%= if @current_scope do %>
      <script>
        window.userToken = <%= raw(Jason.encode!(Phoenix.Token.sign(PoddyclipBackendWeb.Endpoint, "user socket", @current_scope.user.id))) %>;
        window.currentUser = <%= raw(Jason.encode!(%{email: @current_scope.user.email, id: @current_scope.user.id})) %>;
      </script>
    <% end %>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-base-100 min-h-screen">
    <div class="navbar bg-base-200 border-b border-base-300" style="position: fixed; top: 0; left: 0; right: 0; z-index: 40;">
      <div class="navbar-start">
        <%= if @current_scope do %>
          <.link href={locale_path(@locale, "/app")} class="text-xl font-bold px-4 hover:text-primary transition-colors">Munchy Cow</.link>
          <.link href={locale_path(@locale, "/app/past-munchings")} class="text-sm px-3 hover:text-primary transition-colors"><%= gettext("Past Munchings") %></.link>
        <% else %>
          <.link href={locale_path(@locale, "/")} class="text-xl font-bold px-4 hover:text-primary transition-colors">Munchy Cow</.link>
        <% end %>
      </div>
      <div class="navbar-end gap-2 pr-4">
        <!-- Language Switcher -->
        <div class="dropdown dropdown-end">
          <button tabindex="0" class="flex items-center gap-1 text-sm hover:text-primary transition-colors cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802" />
            </svg>
            <%= case @locale do
              "es" -> "ES"
              "it" -> "IT"
              "fr" -> "FR"
              _ -> "EN"
            end %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </button>
          <ul tabindex="0" class="dropdown-content menu bg-base-200 rounded-2xl w-32 p-2 shadow-lg border border-base-300 z-50 mt-2">
            <li><a href={switch_locale_path(assigns, "en")} class={if @locale == "en", do: "active", else: ""}>English</a></li>
            <li><a href={switch_locale_path(assigns, "es")} class={if @locale == "es", do: "active", else: ""}>Español</a></li>
            <li><a href={switch_locale_path(assigns, "it")} class={if @locale == "it", do: "active", else: ""}>Italiano</a></li>
            <li><a href={switch_locale_path(assigns, "fr")} class={if @locale == "fr", do: "active", else: ""}>Français</a></li>
          </ul>
        </div>

        <%= if @current_scope do %>
          <div class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="w-10 h-10 rounded-full bg-base-300 flex items-center justify-center cursor-pointer hover:ring-2 hover:ring-primary/50 transition-all">
              <img src="/images/munchy_cow_head.svg" alt="" class="w-7 h-7" />
            </div>
            <ul tabindex="0" class="dropdown-content menu bg-base-200 rounded-2xl z-50 w-56 p-2 shadow-lg border border-base-300 mt-2">
              <li class="menu-title px-2 py-1">
                <div class="flex items-center justify-between">
                  <span class="text-xs text-base-content/50 truncate">{@current_scope.user.email}</span>
                  <%= if @current_scope.user.subscription_status == "active" do %>
                    <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-primary text-primary-content ml-2"><%= gettext("Pro") %></span>
                  <% else %>
                    <span class="px-2 py-0.5 text-[10px] font-medium rounded-full bg-base-300 text-base-content/70 ml-2"><%= gettext("Free") %></span>
                  <% end %>
                </div>
              </li>
              <%= if @current_scope.user.subscription_status != "active" do %>
                <li class="text-xs text-base-content/50 px-4 py-1">
                  <% mins = div(@current_scope.user.seconds_available, 60) %>
                  <% secs = rem(@current_scope.user.seconds_available, 60) %>
                  <%= "#{mins}m #{secs}s" %> <%= gettext("remaining") %>
                </li>
              <% end %>
              <li><.link href={locale_path(@locale, "/account")}><%= gettext("Account") %></.link></li>
              <li><.link href={locale_path(@locale, "/users/settings")}><%= gettext("Settings") %></.link></li>
              <li><.link href={locale_path(@locale, "/users/log-out")} method="delete"><%= gettext("Log out") %></.link></li>
            </ul>
          </div>
        <% else %>
          <.link href={locale_path(@locale, "/pricing")} class="text-sm px-3 hover:text-primary transition-colors"><%= gettext("Pricing") %></.link>
          <.link href={locale_path(@locale, "/users/log-in")} class="btn btn-primary btn-sm"><%= gettext("Sign in") %></.link>
        <% end %>
      </div>
    </div>
    <div style="padding-top: 4rem;">
      {@inner_content}
    </div>
  </body>
</html>
