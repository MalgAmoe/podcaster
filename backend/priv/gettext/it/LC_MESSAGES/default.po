#: lib/poddyclip_backend_web/controllers/page_html/help.html.heex:31
#, elixir-autogen, elixir-format
msgid "How long does processing take?"
msgstr "Quanto tempo richiede l'elaborazione?"

#: lib/poddyclip_backend_web/controllers/page_html/help.html.heex:11
#, elixir-autogen, elixir-format
msgid "I'm not receiving emails from Munchy Cow"
