FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    clang \
    cmake \
    curl \
    git \
    pkg-config \
    libssl-dev \
 && rm -rf /var/lib/apt/lists/*

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal --default-toolchain 1.88.0
ENV PATH=/root/.cargo/bin:$PATH

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

RUN cargo build --release -p poddyclip-api -p poddyclip-cli

RUN mkdir -p /out/bin /out/lib /out/crates/poddyclip/models \
 && cp target/release/poddyclip-api /out/bin/ \
 && cp target/release/poddyclip /out/bin/ \
 && cp -a crates/poddyclip/models/mossformer2 /out/crates/poddyclip/models/ \
 && find /root/.cache/ort.pyke.io -type f \( -name 'libonnxruntime*.so*' -o -name 'libonnxruntime_providers*.so*' \) -exec cp -a {} /out/lib/ \; \
 && test -f /out/lib/libonnxruntime_providers_shared.so \
 && ls -lah /out/lib

FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04 AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libssl3 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /out/bin /app/bin
COPY --from=builder /out/lib /app/lib
COPY --from=builder /out/crates /app/crates

ENV LD_LIBRARY_PATH=/app/lib
ENV RUST_LOG=info
ENV PORT=3000

EXPOSE 3000

CMD ["/app/bin/poddyclip-api"]
