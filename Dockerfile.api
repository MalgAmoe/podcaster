# Dependency caching with cargo-chef
FROM rust:latest AS chef
RUN cargo install cargo-chef
WORKDIR /app

# Plan dependencies (creates recipe.json)
FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY crates/poddyclip ./crates/poddyclip
COPY crates/poddyclip-api ./crates/poddyclip-api
# Create minimal workspace with inherited fields
RUN printf '[workspace]\nresolver = "2"\nmembers = ["crates/poddyclip", "crates/poddyclip-api"]\n\n[workspace.package]\nversion = "0.1.0"\nedition = "2021"\n\n[profile.release]\nlto = "thin"\nstrip = "symbols"\n' > Cargo.toml
RUN cargo chef prepare --recipe-path recipe.json

# Build dependencies (CACHED layer)
FROM chef AS builder
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json --features deepfilter

# Build app (only this rebuilds on code changes)
COPY Cargo.toml Cargo.lock ./
COPY crates/poddyclip ./crates/poddyclip
COPY crates/poddyclip-api ./crates/poddyclip-api
RUN printf '[workspace]\nresolver = "2"\nmembers = ["crates/poddyclip", "crates/poddyclip-api"]\n\n[workspace.package]\nversion = "0.1.0"\nedition = "2021"\n\n[profile.release]\nlto = "thin"\nstrip = "symbols"\n' > Cargo.toml
RUN cargo build --release -p poddyclip-api --features deepfilter

# Runtime stage
FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/poddyclip-api /app/poddyclip-api
COPY chains /app/chains
ENV CHAINS_DIR=/app/chains
ENV RUST_LOG=info
EXPOSE 3000
CMD ["/app/poddyclip-api"]
